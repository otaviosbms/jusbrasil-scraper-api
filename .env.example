PORT=3000

# Espera mínima (ms) antes de cada navegação real ao Jusbrasil
SCRAPE_MIN_DELAY_MS=12000
# Jitter aleatório (ms) somado à espera mínima, pra não ter intervalo fixo
SCRAPE_JITTER_MS=8000
# Se uma verificação anti-bot for detectada, todas as próximas buscas
# esperam até este cooldown (ms) terminar antes de tentar de novo
SCRAPE_COOLDOWN_MS=300000

# --- Login opcional no Jusbrasil (acesso a conteúdo de assinante) --------------
# Ver docs/AUTH.md antes de usar: exige uma conta Jusbrasil sua e eleva o risco
# de violar os Termos de Uso do site em relação à raspagem anônima.
#
# Usados só pelo script `npm run login` (não pelo servidor em si) pra logar uma
# vez; a sessão fica salva no perfil de navegador em JUSBRASIL_PROFILE_DIR.
# Depois disso pode até apagar essas duas linhas — só o perfil importa pro dia a dia.
JUSBRASIL_EMAIL=
JUSBRASIL_PASSWORD=

# Pasta de perfil persistente do Chromium (cookies, localStorage, cache) usada em
# toda navegação, tanto anônima quanto (depois de `npm run login`) autenticada.
# NUNCA commitar essa pasta — depois do login ela equivale a uma senha. Já está
# no .gitignore (padrão .jusbrasil-browser-profile/).
JUSBRASIL_PROFILE_DIR=.jusbrasil-browser-profile
