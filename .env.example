PORT=3000

# Espera mínima (ms) antes de cada navegação real ao Jusbrasil
SCRAPE_MIN_DELAY_MS=12000
# Jitter aleatório (ms) somado à espera mínima, pra não ter intervalo fixo
SCRAPE_JITTER_MS=8000
# Se uma verificação anti-bot for detectada, todas as próximas buscas
# esperam até este cooldown (ms) terminar antes de tentar de novo
SCRAPE_COOLDOWN_MS=300000
